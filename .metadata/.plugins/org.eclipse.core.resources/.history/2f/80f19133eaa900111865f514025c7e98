package com.expenses.portal.repository;

import java.time.LocalDate;
import java.util.List;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

public interface ExpenseRepository extends JpaRepository<ExpenseEntity, Long> {

    List<ExpenseEntity> findByUserUsername(String username);

    List<ExpenseEntity> findByUserUsernameAndExpenseDateBetween(
            String username,
            LocalDate startDate,
            LocalDate endDate);

    List<ExpenseEntity> findByUserUsernameAndExpenseDateBetweenOrderByExpenseDateDesc(
            String username,
            LocalDate startDate,
            LocalDate endDate);
}